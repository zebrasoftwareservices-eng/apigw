{
	email {$ACME_EMAIL}
	admin off
}

{$GATEWAY_DOMAIN} {
	encode zstd gzip
	reverse_proxy kong:8000

	header {
		-Server
		X-Content-Type-Options nosniff
	}
}

{$ADMIN_DOMAIN} {
	@portal {
		header Kong-Admin-Token {$KONG_ADMIN_TOKEN}
	}

	handle @portal {
		reverse_proxy kong:8001
	}

	# Hide the Admin API from unauthenticated callers.
	respond 404
}

{$PORTAL_API_DOMAIN} {
	encode zstd gzip
	reverse_proxy portal-server:4000

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}
