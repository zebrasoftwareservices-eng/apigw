# Copy to .env with: ./scripts/generate-env.sh gateway.example.com admin.gateway.example.com
GATEWAY_DOMAIN=gateway.example.com
ADMIN_DOMAIN=admin.gateway.example.com
ACME_EMAIL=admin@example.com

# Keep the image pinned. Review Kong release notes before changing it.
KONG_IMAGE=kong:3.9.4
POSTGRES_IMAGE=postgres:17-alpine
CADDY_IMAGE=caddy:2.10-alpine

# Replace both values. generate-env.sh creates cryptographically random values.
POSTGRES_PASSWORD=replace-with-a-random-password
KONG_ADMIN_TOKEN=replace-with-a-random-token
